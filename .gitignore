build/
*.saver
.DS_Store

# Generated model library. Models are code — these are build outputs of
# tools/build-library.py, not sources. Committing them would put ~35 MB into
# history on every re-bake, and a re-bake is a normal part of the authoring loop.
# Run tools/build-library.py before tools/build-saver.sh on a fresh clone.
Savers/*/Assets/*.usdz
Savers/*/Assets/*.json

# Generated grain library. Sounds are code too — a bubble's pitch follows from its
# radius alone, so the source of truth is tools/build-audio.py and these WAVs are its
# output. Run it before tools/build-saver.sh if you want a tank with a voice.
Savers/*/Assets/audio/

# Blender
*.blend1
*.blend2
__pycache__/
*.pyc

# Spike output is regenerable; the scripts that produce it are not
spikes/**/out/

# Agent worktrees are scratch, not source
.claude/worktrees/

# The image-inspection tools' interpreter. `uv venv --python 3.14.3 .venv` then
# `uv pip install --python .venv/bin/python numpy scipy pillow`.
.venv/

# Spike 009 build outputs (USDZ, renders, probe binary) — regenerated by its README recipe.
spikes/009-part-channel/output/
spikes/010-shader-uniform-block/output/
